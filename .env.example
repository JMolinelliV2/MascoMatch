POSTGRES_DB=petmatch
POSTGRES_USER=petmatch
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql+psycopg://petmatch:change-me-locally@db:5432/petmatch
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=60
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
GEOCODER_BASE_URL=https://photon.komoot.io
NEXT_PUBLIC_SEARCH_COUNTRY=UY
MINIO_ROOT_USER=petmatch
MINIO_ROOT_PASSWORD=change-this-minio-password
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=pet-photos
S3_ACCESS_KEY=petmatch
S3_SECRET_KEY=change-this-minio-password
MAX_PHOTO_SIZE_BYTES=10485760

# Local AI. No API key or paid provider is used.
# Set true after downloading the model and start Compose with --profile ai-local.
AI_ENABLED=false
AI_TEXT_MODEL=gemma3:4b
AI_VISION_MODEL=gemma3:4b
OLLAMA_BASE_URL=http://ollama:11434
REDIS_URL=redis://redis:6379/0
AI_REQUEST_TIMEOUT_SECONDS=180
AI_MAX_ATTEMPTS=3
AI_DISPATCH_INTERVAL_SECONDS=5

# Linked sightings and conservative semantic photo matching.
LINKED_MATCH_THRESHOLD=0.75
LINKED_FEATURE_CONFIDENCE=0.7
API_INTERNAL_URL=http://api:8000/api/v1

# SMTP credentials are backend-only. No paid account is needed for Brevo Free.
# Set 'smtp' with a verified sender to send real alerts; 'preview' uses local Mailpit.
MAIL_DELIVERY_MODE=disabled
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=PetMatch <avisos@petmatch.local>
SMTP_TLS_MODE=starttls
PUBLIC_SITE_URL=http://localhost:3000

