FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HF_HUB_DISABLE_TELEMETRY=1
WORKDIR /app
COPY requirements.lock requirements-vision.txt ./
RUN pip install --no-cache-dir -r requirements.lock
RUN pip install --no-cache-dir torch==2.13.0 torchvision==0.28.0 --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r requirements-vision.txt
COPY . .
RUN useradd --uid 10001 --create-home mascomatch
USER 10001:10001
CMD ["python", "-m", "app.analysis.worker"]
